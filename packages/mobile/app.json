{
  "expo": {
    "name": "Festie",
    "slug": "festie",
    "version": "1.1.0",
    "scheme": "festie",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/ed47ea14-6364-4646-871d-99edbf17613b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "us.festie.app",
      "associatedDomains": ["applinks:festie.us", "webcredentials:festie.us"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Festie uses your location to drop a meeting point, point you toward your crew, and—only when you turn it on—share your live location with your crew or send an SOS. Only used while the app is open.",
        "NSCameraUsageDescription": "Festie uses the camera to scan a friend's plan QR code so they can join your festival plan offline."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "package": "us.festie.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#080810",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "festie.us",
              "pathPrefix": "/set"
            },
            {
              "scheme": "https",
              "host": "festie.us",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080810",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Festie to access your photos to set your avatar."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#ff3366"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "festi-jn",
          "project": "festie"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Festie uses your location to drop a meeting point, point you toward your crew, and—only when you turn it on—share your live location with your crew or send an SOS. Only used while the app is open."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Festie uses the camera to scan a friend's plan QR code so they can join your festival plan offline."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed47ea14-6364-4646-871d-99edbf17613b"
      }
    },
    "owner": "uhsear"
  }
}
