{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // TODO: Enable "noUncheckedIndexedAccess": true incrementally.
    // As of 2026-05-07 it produces ~50 errors across 15 files (conflicts.ts,
    // format.ts, StageBadge.tsx, crew.tsx, grid.tsx, LineupImport.tsx, etc.).
    // Fix files one at a time, then flip the flag.
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@festie/shared/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
