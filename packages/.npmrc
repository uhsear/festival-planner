onlyBuiltDependenciesFile: ""
# Hoist Expo config-plugin shared deps to the workspace root node_modules so
# third-party config plugins that `require('@expo/config-plugins')` at module
# load (e.g. @sentry/react-native) can resolve it under pnpm's isolated layout.
# Without this, `expo config` / `eas build` fail locally with
# "Cannot find module '@expo/config-plugins'".
# NOTE: declaring any public-hoist-pattern[] REPLACES pnpm's defaults
# (*eslint*, *prettier*). Without re-declaring them, the eslint binary stops
# being hoisted to the root node_modules/.bin and `@festie/web`'s `eslint src/`
# breaks in clean CI installs ("sh: eslint: not found"). Re-add the defaults.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@expo/config-plugins
public-hoist-pattern[]=@expo/config
# Supply-chain: npm >=11.10 waits 7 days before resolving newly published versions.
min-release-age=7
