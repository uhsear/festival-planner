onlyBuiltDependenciesFile: ""
# Hoist Expo config-plugin shared deps to the workspace root node_modules so
# third-party config plugins that `require('@expo/config-plugins')` at module
# load (e.g. @sentry/react-native) can resolve it under pnpm's isolated layout.
# Without this, `expo config` / `eas build` fail locally with
# "Cannot find module '@expo/config-plugins'".
public-hoist-pattern[]=@expo/config-plugins
public-hoist-pattern[]=@expo/config
