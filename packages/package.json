{
  "name": "festie-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @festie/mobile dev",
    "build": "pnpm --filter @festie/web build",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "typecheck:fast": "pnpm -r --parallel typecheck:fast",
    "test": "pnpm -r --parallel test"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": ">=7.0.5",
      "basic-ftp": ">=5.3.1",
      "@types/react-dom": "~19.1.0",
      "workbox-build": "^7.4.1",
      "eslint": "^9.39.0",
      "esbuild": ">=0.28.1",
      "ws": ">=8.21.0",
      "tmp": ">=0.2.6",
      "qs": ">=6.15.2",
      "undici": "^7.28.0",
      "form-data": ">=4.0.6",
      "uuid": ">=11.1.1"
    }
  },
  "devDependencies": {
    "@typescript/native-preview": "latest",
    "typescript": "~5.8.0"
  }
}
