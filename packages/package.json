      "esbuild": ">=0.28.1",
      "ws": ">=8.21.0",
      "tmp": ">=0.2.6",
      "qs": ">=6.15.2",
      "undici": "^7.29.0",
      "form-data": ">=4.0.6",
      "uuid": ">=11.1.1",
      "axios": "^1.18.0",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "browserslist": "^4.28.7",
      "fast-uri": "^3.1.6",
