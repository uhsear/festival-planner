{
  "baseDir": "dist",
  "files": [
    { "path": "assets/react-core-*.js", "maxSize": "50kb" },
    { "path": "assets/router-*.js", "maxSize": "30kb" },
    { "path": "assets/data-*.js", "maxSize": "25kb" },
    { "path": "assets/ui-motion-*.js", "maxSize": "30kb" },
    { "path": "assets/index-*.js", "maxSize": "100kb" },
    { "path": "assets/index-*.css", "maxSize": "30kb" },
    { "path": "assets/*.js", "maxSize": "150kb", "maxPercentIncrease": 10 }
  ],
  "defaultCompression": "gzip"
}
