# Normalize line endings to LF on commit; check out platform-native.
# Fixes recurring CRLF/LF churn on Windows checkouts.
* text=auto eol=lf

# Explicit text files (force LF in the repo regardless of platform)
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.css   text eol=lf
*.md    text eol=lf

# Binary files (never normalize, never diff as text)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
