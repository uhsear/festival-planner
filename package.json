{
  "name": "festie",
  "version": "3.0.0",
  "description": "Interactive festival set schedule planner with group coordination",
  "type": "module",
  "main": "server.ts",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/uhsear/festival-planner.git"
  },
  "homepage": "https://festie.us",
  "bugs": {
    "url": "https://github.com/uhsear/festival-planner/issues"
  },
  "author": "Asir Khan <asir@festie.us>",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --import tsx/esm server.ts",
    "dev": "node --import tsx/esm server.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsgo --noEmit",
    "gen:api-types": "node scripts/gen-api-types.mjs",
    "gen:api-types:check": "node scripts/gen-api-types.mjs && git diff --exit-code -- lib/openapi.generated.json packages/shared/src/types/api.gen.ts",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx/esm --test --test-force-exit --test-concurrency=1 tests/*.test.ts",
    "test:unit": "node --import tsx/esm --test --test-force-exit tests/unit.test.ts",
    "test:coverage": "c8 node --import tsx/esm --test --test-force-exit --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "lint": "eslint lib/ routes/ server.ts",
    "lint:fix": "eslint --fix lib/ routes/ server.ts",
    "db:backup": "bash scripts/backup-pg.sh",
    "test:db:up": "docker run -d --rm --name festie-test-db -e POSTGRES_USER=festie -e POSTGRES_PASSWORD=festie -e POSTGRES_DB=festie_test -p 5433:5432 postgres:16-alpine",
    "test:db:migrate": "for f in migrations/*.sql; do PGPASSWORD=festie psql -h localhost -p 5433 -U festie -d festie_test -f \"$f\"; done",
    "test:db:down": "docker rm -f festie-test-db",
    "lhci": "bash scripts/lhci-run.sh",
    "lhci:localhost": "bash scripts/lhci-run.sh localhost",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts --project=chromium",
    "test:visual:update": "playwright test tests/e2e/visual-regression.spec.ts --project=chromium --update-snapshots",
    "test:visual:auth": "playwright test --project=visreg-auth",
    "test:visual:auth:update": "playwright test --project=visreg-auth --update-snapshots",
    "depcruise": "depcruise \"lib/**/*.ts\" \"routes/**/*.ts\" server.ts --config .dependency-cruiser.cjs",
    "knip": "knip",
    "syncpack": "syncpack lint"
  },
  "dependencies": {
    "@sentry/node": "^10.48.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.78.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "firebase-admin": "~13.10.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "multer": "^2.1.1",
    "pg": "~8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "socket.io": "~4.8.3",
    "swagger-ui-dist": "^5.32.5",
    "tsx": "^4.19.0",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "c8": "^12.0.0",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-sql": "^3.4.1",
    "globals": "^17.12.0",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "openapi-typescript": "^7.13.0",
    "simple-git-hooks": "^2.14.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "syncpack": "^15.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "protobufjs": ">=8.6.0"
  }
}
