{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // TS 6.0 changed the `types` default from auto-loading all @types to [];
    // declare node explicitly so process/Buffer/__dirname globals keep resolving.
    "types": ["node"],
    "noEmit": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["server.ts", "lib/**/*.ts", "routes/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "packages"]
}
