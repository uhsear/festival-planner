# ──────────────────────────────────────────────────────────────────────────────
# Festie crontab entries
#
# Install: crontab -e  (then paste the lines below)
# Verify:  crontab -l
#
# All scripts log to $APP_DIR/logs/. Create the directory first:
#   mkdir -p /opt/festie/logs
#
# Adjust APP_DIR to your deployment path.
# ──────────────────────────────────────────────────────────────────────────────

APP_DIR=/opt/festie

# ── Database backups ─────────────────────────────────────────────────────────

# Daily backup at 2:00 AM (pg_dump custom format, 30-day daily + 12 weekly)
0 2 * * * cd $APP_DIR && bash scripts/backup-pg.sh >> logs/backup.log 2>&1

# Off-site sync at 3:00 AM (after local backup completes)
# Requires OFFSITE_TARGET in .env (rsync path, rclone remote, or scp target)
0 3 * * * cd $APP_DIR && bash scripts/backup-offsite.sh >> logs/backup-offsite.log 2>&1

# ── Health monitoring ────────────────────────────────────────────────────────

# Health check every 5 minutes (alerts via webhook, auto-restarts after 3 fails)
*/5 * * * * cd $APP_DIR && bash scripts/health-check.sh >> logs/health-check.log 2>&1

# Error rate alerting every 5 minutes (checks PM2 error logs + /api/health)
*/5 * * * * cd $APP_DIR && node scripts/error-rate-alert.js >> logs/alert.log 2>&1

# Health monitor (Node.js version, more comprehensive) every 5 minutes
# Use EITHER health-check.sh OR health-monitor.js, not both
# */5 * * * * cd $APP_DIR && node scripts/health-monitor.js >> logs/cron-health.log 2>&1

# ── Maintenance ──────────────────────────────────────────────────────────────

# Audit log cleanup: 1st of each month at 4:17 AM (prune rows older than 90d)
17 4 1 * * cd $APP_DIR && bash scripts/audit-log-cleanup.sh >> logs/audit-log-cleanup.log 2>&1

# Application log cleanup daily at 5:00 AM (rotate deploy.log, migrate.log)
0 5 * * * cd $APP_DIR && bash scripts/log-cleanup.sh >> logs/log-cleanup.log 2>&1
